        "# try-catch兩數相除\n",
        "# 在這裡寫程式\n",
        "def safe_divide(a,b):\n",
        "    try:\n",
        "        return a/b\n",
        "    except:\n",
        "        return \"Error:除以零\"\n",
        ""
      ]
