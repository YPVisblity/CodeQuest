      "source": [
        "# 等差數列\n",
        "# 請建立一個sequence串列後使用公式term = a + i * d計算等差數列。\n",
        "\n",
        "def generate_arithmetic_sequence(a, d, n):\n",
        "\n",
        "    result = []\n",
        "\n",
        "    for i in range(n):\n",
        "        result.append(a + i * d)\n",
        "\n",
        "    return result"
      ]
    }
  ]
}