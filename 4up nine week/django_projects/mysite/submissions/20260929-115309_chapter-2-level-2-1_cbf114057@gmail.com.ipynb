      "source": [
        "def safe_divide(a, b):\n",
        "  try:\n",
        "    # 使用 float(a) 確保結果一定會是浮點數（例如 5.0）\n",
        "    return float(a) / b\n",
        "  except (ZeroDivisionError, TypeError, ValueError):\n",
        "    # 捕捉除以零、型別錯誤或無法轉換的數值錯誤，統一回傳 \"ERROR\"\n",
        "    return \"ERROR\""
      ]
    }
  ]
}