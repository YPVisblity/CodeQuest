      "source": [
        "# 矩陣最大值\n",
        "# 在這裡寫程式\n",
        "def matrix_max(matrix):\n",
        "    max_value = matrix[0][0]\n",
        "    for row in matrix:\n",
        "        for number in row:\n",
        "            if number > max_value:\n",
        "                max_value = number\n",
        "    return max_value"
      ]
    }
  ]
}