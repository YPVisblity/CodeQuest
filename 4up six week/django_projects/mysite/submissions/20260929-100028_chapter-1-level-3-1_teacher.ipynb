      "source": [
        "# 矩陣相加\n",
        "# 在這裡寫程式\n",
        "\n",
        "def matrix_add(A,B):\n",
        "    C = [[0 for i in range(len(A[0]))] for j in range(len(A))]\n",
        "    for i in range(len(A)):\n",
        "        for j in range(len(A[0])):\n",
        "            C[i][j]=A[i][j]+B[i][j]\n",
        "            \n",
        "    return C"
      ]
    }
  ]
}