      "source": [
        "# 請定義一個matrix_add(A,B)函數，計算函數相加。使用for迴圈\n",
        "def matrix_add(A, B):\n",
        "\n",
        "    result = []\n",
        "\n",
        "    for i in range(len(A)):\n",
        "\n",
        "        row = []\n",
        "\n",
        "        for j in range(len(A[0])):\n",
        "            row.append(A[i][j] + B[i][j])\n",
        "\n",
        "        result.append(row)\n",
        "\n",
        "    return result"
      ]
    }
  ]
}